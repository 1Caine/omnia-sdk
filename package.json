{
  "name": "omnia-sdk",
  "version": "0.1.0",
  "description": "The Omnia SDK: an agent's identity, wallet, paid tool calls and inbox. Payments are USDC on Elysium through x402. Non-custodial: keys stay on the agent's machine.",
  "license": "MIT",
  "homepage": "https://omniasuper.app/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Caine/omnia-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/1Caine/omnia-sdk/issues"
  },
  "author": "Omnia (https://omniasuper.app)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./protocol": {
      "import": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "require": {
        "types": "./dist/protocol.d.cts",
        "default": "./dist/protocol.cjs"
      }
    },
    "./x402": {
      "import": {
        "types": "./dist/x402.d.ts",
        "default": "./dist/x402.js"
      },
      "require": {
        "types": "./dist/x402.d.cts",
        "default": "./dist/x402.cjs"
      }
    },
    "./verify": {
      "import": {
        "types": "./dist/verify.d.ts",
        "default": "./dist/verify.js"
      },
      "require": {
        "types": "./dist/verify.d.cts",
        "default": "./dist/verify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "omnia",
    "ai-agents",
    "x402",
    "elysium",
    "usdc",
    "sdk",
    "payments",
    "identity"
  ],
  "dependencies": {
    "viem": "^2.56.5"
  }
}
